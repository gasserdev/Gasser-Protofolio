<nav x-data="{ open: false, atTop: true }" 
     @scroll.window="atTop = window.pageYOffset > 20 ? false : true"
     class="fixed top-0 w-full z-50 transition-all duration-300 py-4 px-6"
     :class="atTop && !open ? 'bg-transparent' : 'bg-[#070d1f] shadow-lg'"
     :style="!atTop || open ? 'background: #070d1f;' : ''">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div class="font-bold text-cyan-400 text-2xl font-['Space_Grotesk'] tracking-tighter">Gasser Zayed</div>
        
        <div class="hidden md:flex gap-8 text-sm font-bold tracking-tight">
            <a href="#work" class="hover:text-cyan-400 transition">WORK</a>
            <a href="#skills" class="hover:text-cyan-400 transition">SKILLS</a>
            <a href="#contact" class="hover:text-cyan-400 transition">CONTACT</a>
        </div>

        <button @click="open = !open" class="md:hidden text-cyan-400 p-2" aria-label="Toggle menu">
            <span x-show="!open" class="material-symbols-outlined text-3xl">menu</span>
            <span x-show="open" class="material-symbols-outlined text-3xl">close</span>
        </button>
    </div>

    <div x-show="open" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-x-full"
         x-transition:enter-end="opacity-100 translate-x-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-x-0"
         x-transition:leave-end="opacity-0 translate-x-full"
         @click.outside="open = false"
         class="fixed top-0 right-0 h-full w-72 bg-[#070d1f] border-l border-white/10 md:hidden z-50 shadow-[-8px_0_30px_rgba(0,0,0,0.5)]">
        
        <div class="p-6">
            <div class="flex justify-between items-center mb-12">
                <span class="font-bold text-cyan-400 text-xl font-['Space_Grotesk']">Menu</span>
                <button @click="open = false" class="text-slate-400 hover:text-cyan-400">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <div class="flex flex-col gap-6">
                <a href="#work" @click="open = false" 
                   class="flex items-center gap-4 text-lg font-bold text-slate-300 hover:text-cyan-400 transition group">
                    <span class="material-symbols-outlined text-2xl group-hover:scale-110 transition-transform">work</span>
                    WORK
                </a>
                <a href="#skills" @click="open = false" 
                   class="flex items-center gap-4 text-lg font-bold text-slate-300 hover:text-cyan-400 transition group">
                    <span class="material-symbols-outlined text-2xl group-hover:scale-110 transition-transform">code</span>
                    SKILLS
                </a>
                <a href="#contact" @click="open = false" 
                   class="flex items-center gap-4 text-lg font-bold text-slate-300 hover:text-cyan-400 transition group">
                    <span class="material-symbols-outlined text-2xl group-hover:scale-110 transition-transform">mail</span>
                    CONTACT
                </a>
            </div>

            <div class="absolute bottom-8 left-6 right-6">
                <div class="flex gap-4">
                    <a href="https://github.com/gasserdev" target="_blank" class="text-slate-500 hover:text-cyan-400 transition">
                        <span class="material-symbols-outlined text-2xl">code</span>
                    </a>
                    <a href="https://linkedin.com/in/gasserdev" target="_blank" class="text-slate-500 hover:text-blue-500 transition">
                        <span class="material-symbols-outlined text-2xl">share</span>
                    </a>
                    <a href="https://youtube.com/@gasserdev" target="_blank" class="text-slate-500 hover:text-red-500 transition">
                        <span class="material-symbols-outlined text-2xl">smart_display</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div x-show="open" class="fixed inset-0 bg-black/50 md:hidden z-40" @click="open = false"></div>
</nav>
